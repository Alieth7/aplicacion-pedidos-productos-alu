<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="10dp">


    <ImageView
        android:id="@+id/imgview_Cuaderno"
        android:layout_width="309dp"
        android:layout_height="180dp"
        android:layout_gravity="center"

        tools:srcCompat="@tools:sample/avatars" />
    <!--android:layout_gravity="center"-->
    <!--el problema era que estaba en wrap content y eso al parecer hacia que -->

    <LinearLayout
        android:layout_width="343dp"
        android:layout_height="wrap_content"
        android:layout_margin="15dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txt_Descripcion"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:hint="Descripcion del cuaderno..."
            android:textColor="@color/latte_primary" />

        <ImageButton
            android:id="@+id/imgbtn_Add"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:backgroundTint="@color/brownie"

            app:srcCompat="@drawable/ic_add" />


    </LinearLayout>
</LinearLayout>